Subject: [PATCH RFC v2] drm/amdgpu/mes12: bound and validate late API status

Offline review candidate only. NOT APPROVED FOR INSTALLATION.

Accept only the exact submitted success value (1), stop on the first
nonzero status, and limit the added atomic poll to min(remaining, 100) us.

This fixes the v1 malformed/mixed-status acceptance and bounds its extra
nominal busy-wait, but does not solve or rule out stale completion writes
into a WB slot reused after an earlier timeout. A current completion and
an old completion both carrying 1 are indistinguishable in this protocol.
Do not deploy until this ownership/lifetime question is resolved.

---

diff --git a/amd/amdgpu/mes_v12_0.c b/amd/amdgpu/mes_v12_0.c
--- a/amd/amdgpu/mes_v12_0.c
+++ b/amd/amdgpu/mes_v12_0.c
@@ -22,6 +22,7 @@
  */
 
 #include <linux/firmware.h>
+#include <linux/iopoll.h>
 #include <linux/module.h>
 #include "amdgpu.h"
 #include "gfx_v12_0.h"
@@ -165,6 +166,7 @@
 	u64 status_gpu_addr;
 	u32 seq, status_offset;
 	u64 *status_ptr;
+	u64 status;
 	signed long r;
 	int ret;
 
@@ -234,20 +236,36 @@
 	r = amdgpu_fence_wait_polling(ring, seq, timeout);
 
 	/*
-	 * status_ptr[31:0] == 0 (fail) or status_ptr[63:0] == 1 (success).
-	 * If status_ptr[31:0] == 0 then status_ptr[63:32] will have debug error information.
+	 * A completed scheduler fence can be observed before the API status
+	 * writeback. Give an unwritten status at most 100 us of the remaining
+	 * fence timeout budget, without delaying the normal success path.
+	 * Stop on any nonzero value; an error must never be polled away.
+	 * READ_ONCE provides a CPU snapshot, not a firmware ordering guarantee.
 	 */
-	if (r < 1 || !(lower_32_bits(*status_ptr))) {
+	status = READ_ONCE(*status_ptr);
+	if (r > 0 && !status)
+		read_poll_timeout_atomic(READ_ONCE, status, status, 1,
+					min_t(signed long, r, 100), false,
+					*status_ptr);
+
+	/* Only the exact value submitted above is accepted as success. */
+	if (r < 1 || status != 1) {
 
 		if (misc_op_str)
-			dev_err(adev->dev, "MES(%d) failed to respond to msg=%s (%s)\n",
-				pipe, op_str, misc_op_str);
+			dev_err(adev->dev,
+				"MES(%d) failed to respond to msg=%s (%s) fence_wait_ret=%ld status=0x%08x_%08x\n",
+				pipe, op_str, misc_op_str, r,
+				upper_32_bits(status), lower_32_bits(status));
 		else if (op_str)
-			dev_err(adev->dev, "MES(%d) failed to respond to msg=%s\n",
-				pipe, op_str);
+			dev_err(adev->dev,
+				"MES(%d) failed to respond to msg=%s fence_wait_ret=%ld status=0x%08x_%08x\n",
+				pipe, op_str, r,
+				upper_32_bits(status), lower_32_bits(status));
 		else
-			dev_err(adev->dev, "MES(%d) failed to respond to msg=%d\n",
-				pipe, x_pkt->header.opcode);
+			dev_err(adev->dev,
+				"MES(%d) failed to respond to msg=%d fence_wait_ret=%ld status=0x%08x_%08x\n",
+				pipe, x_pkt->header.opcode, r,
+				upper_32_bits(status), lower_32_bits(status));
 
 		while (halt_if_hws_hang)
 			schedule();
